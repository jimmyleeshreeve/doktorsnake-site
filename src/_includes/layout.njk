<!DOCTYPE html>
<html lang="en">
<head>

{% set metaDescription = description | default("Hacking the system · Breaking the code") %}
{% set canonicalUrl = "https://www.doktorsnake.com" + page.url %}
{% set ogImage = ogImage | default("https://doktorsnake.com/assets/img/og-doktorsnake.jpg") %}
{% set ogImageAlt = ogImageAlt | default("Doktor Snake — Magick, Spellcasting, Mind Power") %}
{% set ogType = ogType | default("website") %}

{% if title %}
  {% set metaTitle = title + " • Doktor Snake" %}
{% else %}
  {% set metaTitle = "Doktor Snake" %}
{% endif %}

  <!-- Primary meta -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#050505" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">
  <link rel="icon" href="/assets/img/favicon.ico">

  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}" />

  {% if noindex %}
  <meta name="robots" content="noindex, nofollow" />
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jimmy Lee Shreeve",
    "alternateName": "Doktor Snake",
    "url": "https://www.doktorsnake.com",
    "sameAs": [
      "https://doktorsnake.io"
    ]
  }
  </script>

  <!-- Open Graph -->
  <meta property="og:site_name" content="DoktorSnake" />
  <meta property="og:type" content="{{ ogType }}" />
  <meta property="og:title" content="{{ metaTitle }}" />
  <meta property="og:description" content="{{ metaDescription }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:image" content="{{ ogImage }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogImageAlt }}" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ metaTitle }}" />
  <meta name="twitter:description" content="{{ metaDescription }}" />
  <meta name="twitter:image" content="{{ ogImage }}" />
  <meta name="twitter:site" content="@DoktorSnakeHQ" />

  <title>{{ metaTitle }}</title>
  <link rel="stylesheet" href="/assets/css/main.css">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LZFFBTWV9D"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-LZFFBTWV9D');
</script>


</head>

<body>
  <header class="wrap top">
    <a class="brand" href="/">Doktor Snake</a>

<nav class="nav">

  <div class="nav-dropdown">
    <button class="nav-dropbtn" aria-expanded="false">Workings ▾</button>
    <div class="nav-dropdown-content">
      <a href="/influence/">Influence</a>
      <a href="/diabolus/">Diabolus</a>
      <a href="/dispatch/">Dispatch</a>
    </div>
  </div>

  <a href="/readings/">Readings</a>
  <a href="/consultation/">Consultations</a>

  <div class="nav-dropdown">
    <button class="nav-dropbtn">Work With Me ▾</button>
    <div class="nav-dropdown-content">
      <a href="/dokology/">Dokology</a>
      <a href="/retainer/">Retainer</a>
    </div>
  </div>

<div class="nav-dropdown">
  <button class="nav-dropbtn">Talismans ▾</button>
  <div class="nav-dropdown-content">
    <a href="/talismans/">Physical Talismans</a>
    <a href="/digital-talismans/">Digital Talismans</a>
    <a href="/inner-practices/">Inner Practices</a>
  </div>
</div>

  <a href="/newsletter/">Newsletter</a>
  <a href="/contact/">Contact</a>

</nav>

  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <hr class="ds-hr ds-hr--dots">

  <footer class="wrap footer">
    <div class="footer-about">
      <h3>About</h3>
      <p>
        Doktor Snake (Jimmy Lee Shreeve) —
        author, former journalist, occult fixer, and mind power consultant.
      </p>

      <p class="footer-links">
        <a href="/about/">Full background →</a>
        <span aria-hidden="true">·</span>
        <a href="/press/">Press →</a>
        <span aria-hidden="true">·</span>
        <a href="/terms/">Terms / Transaction Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact/">Contact</a>
      </p>
    </div>

    <div class="footer-divider"></div>

    <small class="copy-note">
      CopyWrong © DoktorSnake.com<br>
      Files replicate. Leverage does not.
    </small>
  </footer>

  <script src="/assets/js/site.js"></script>
  <script>
  const dropdowns = document.querySelectorAll('.nav-dropdown');

  dropdowns.forEach(dropdown => {
    const button = dropdown.querySelector('.nav-dropbtn');

    button.addEventListener('click', event => {
      event.stopPropagation();

      const isOpen = dropdown.classList.contains('is-open');

      dropdowns.forEach(item => {
        item.classList.remove('is-open');

        const itemButton = item.querySelector('.nav-dropbtn');
        if (itemButton) {
          itemButton.setAttribute('aria-expanded', 'false');
        }
      });

      if (!isOpen) {
        dropdown.classList.add('is-open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', () => {
    dropdowns.forEach(dropdown => {
      dropdown.classList.remove('is-open');

      const button = dropdown.querySelector('.nav-dropbtn');
      if (button) {
        button.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      dropdowns.forEach(dropdown => {
        dropdown.classList.remove('is-open');

        const button = dropdown.querySelector('.nav-dropbtn');
        if (button) {
          button.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
</script>
</body>
</html>
